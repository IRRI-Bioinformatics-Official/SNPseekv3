											<textbox
												id="textboxVarlistName" style="width:190px !important;" />

											<button label="Create List"
												id="buttonCreateVarlist"
												style="width: 190px !important;border-radius: 10px;" />
											<space bar="true"
												spacing="15px" />
											<label value="Filters"
												style="font-size:13px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Fira Sans,Droid Sans,Helvetica Neue,sans-serif;" />
											<label
												style="font-size:13px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Fira Sans,Droid Sans,Helvetica Neue,sans-serif;" />
											<label value="Column: "
