								<goldenpanel id="gp_snpeffect" area="A"
									title="Snp Effect" closable="false">
									<vlayout>
										<toolbar id="toolbar_download"
											visible="false">
											<hlayout>
												<button
													id="btn_downloadSnpEffect" label="Download" />
											</hlayout>
										</toolbar>
										<listbox id="listboxSnpeff"
											mold="paging" pageSize="15" sizedByContent="true"
											span="true">
											<listhead sizable="true">

												<listheader
													label="POSITION" sort="auto" width="10%" />
												<listheader
													label="&quot;DELETERIOUSNESS&quot;" sort="auto" width="10%"
													sortAscending="${snpeffasc1}"
													sortDescending="${snpeffdsc1}" />
												<listheader
													label="Alt (ANN)" sort="auto" width="100px" />
												<listheader
													label="Effect (ANN)" sort="auto" width="100px" />
												<listheader
													label="Putative_impact (ANN)" sort="auto" width="10%" />
												<listheader
													label="Gene Name (ANN)" sort="auto" width="10%" />
												<listheader
													label="Gene ID (ANN)" sort="auto" width="10%" />
												<listheader
													label="Feature type (ANN)" sort="auto" width="10%" />
												<listheader
													label="Feature ID (ANN)" sort="auto" width="10%" />
												<listheader
													label="Transcript Biotype (ANN)" sort="auto" width="10%" />
												<listheader
													label="Rank/Total (ANN)" sort="auto" width="10%" />
												<listheader
													label="HGV S.c (ANN)" sort="auto" width="10%" />
												<listheader
													label="HGV S.p (ANN)" sort="auto" width="10%" />
												<listheader
													label="cDNA position (ANN)" sort="auto" width="10%" />
												<listheader
													label="cDS position (ANN)" sort="auto" width="10%" />
												<listheader
													label="Protein position" sort="auto" width="10%" />
												<listheader
													label="Distance to feature (ANN)" sort="auto" width="10%" />
												<listheader
													label="Errors,Warnings Info msgs (ANN)" sort="auto"
													width="10%" />
												<listheader label="LOF"
													sort="auto" width="10%" />
												<listheader label="NMD"
													sort="auto" width="10%" />
											</listhead>
										</listbox>

									</vlayout>

								</goldenpanel>
								<goldenpanel id="gp_jbrowse" area="A"
									title="Jbrowse" draggable="true" closable="false">
									<vbox
										style="height:100%;width:100%;">
										<hbox>
											<label id="msgJbrowse"
												visible="false"
												style="font-family: -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Fira Sans,Droid Sans,Helvetica Neue,sans-serif;font-size:16px" />

											<hbox width="80px" />

											<div id="divNucleotide"
												visible="false">
												<label
													value="SNP Genotype Track color code:     " pre="true" />
												<label value="A  "
													style="color:green" pre="true" />
												<label value="T  "
													style="color:red" pre="true" />
												<label value="G  "
													style="color:orange" pre="true" />
												<label value="C  "
													style="color:blue" pre="true" />
												<label
													value="heterozygous   "
													style="color:yellow;background:gray" pre="true" />
											</div>

											<div
												id="divNucleotideIndels" visible="false">
												<label
													value="SNP Genotype Track color code:     " pre="true" />
												<label
													value="insertion  " style="color:green" pre="true" />
												<label
													value="snp/substitution   " style="color:red" pre="true" />
												<label
													value="deletion  " style="color:blue" pre="true" />
												<label
													value="heterozygous   "
													style="color:yellow;background:gray" pre="true" />
												<label
													value="reference   " style="color:black" pre="true" />
											</div>


											<div id="divMismatch"
												visible="false">
												<label
													value="SNP Genotype Track color code:     " pre="true" />
												<label
													value="non-synonymous mismatch " style="color:red"
													pre="true" />
												<label
													value="synonymous mismatch " style="color:darkgray"
													pre="true" />
												<!--  label value="allele match   " style="color:white;background:lightgray" pre="true"/ -->
												<label
													value="heterozygous   "
													style="color:yellow;background:gray" pre="true" />
												<!-- label value="insertion   " style="color:green" pre="true"/>
													<label value="deletion   " style="color:blue" pre="true"/>
													<label value="reference   " style="color:black" pre="true"/ -->
												<label
													value="splice donor SNP " style="color:aqua" pre="true" />
												<label
													value="splice acceptor SNP " style="color:chartreuse"
													pre="true" />

											</div>

											<!--  div id="divBlackSyn"  visible="false">
												<label value="synonymous mismatch " style="color:darkgray" pre="true"/>
												</div -->

										</hbox>
										<iframe id="iframeJbrowse"
											align="left" visible="true"
											style="width:100%;height:100%;border:0px inset;"
											src="${jbrowsestart}" />


									</vbox>

								</goldenpanel>
								<goldenpanel area="A"
									id="gp_template" title="template" closable="false">
								</goldenpanel>
								<goldenpanel area="A"
									id="gp_haplotype" title="Haplotype" closable="false">
									<borderlayout
										style="height:100%;">
										<west
											id="HaplotypeViewHeader" title="Haplotype View Options"
											style="width:310px;"
											splittable="true" collapsible="true" autoscroll="true">
											<div style="overflow:auto; height:100%;">
												<vbox>
													<label
														value="Resolution " pre="true" />
													<listbox
														id="listboxHaploResolution" mold="select"
														style="width:240px!important;" tooltip="test1"
														tooltiptext="Test2">
														<listitem
															value="SNP" label="per SNP" selected="true" />
														<listitem
															value="100" label="per 100bp" />
														<listitem
															value="10" label="per 10bp" />
													</listbox>
													<vbox
														height="20px" />
													<label
														value="Clustering distance weight " pre="true" />
													<hbox>
														<label
															id="labelGlobal" value="Global 0.15" />
														<slider
															id="sliderClusterWieght" mode="decimal" step="0.05"
															maxpos="1.0" minpos="0.0" curpos="0.85" width="150px" />
														<label
															id="labelLocal" value="Local 0.85" />
														<vbox
															width="20px" />
													</hbox>
													<vbox
														height="20px" />
													<label
														value="Download" />
													<hbox>
														<button
															id="buttonHaploOrder" class="z-variety-order"
															label="Variety order" disabled="true"
															style="font-size:12px;" />
														<vbox
															width="10px" />
														<button
															id="buttonHaploImage" class="z-image" label="Image"
															disabled="true" style="font-size:12px;" />
													</hbox>
													<vbox
														height="20px" />
													<label
														value="Group varieties (by haplotypes) using"
														pre="true" />
													<vbox
														width="20px" />
													<listbox
														id="listboxKgroupMethod" mold="select"
														style="width:240px !important">
														<!--  listitem value="kmeans" label="K-means"  -->
														<listitem
															value="nogroups" label="no grouping" />
														<listitem
															value="autogroup" label="auto-group" />
														<listitem
															value="cuttreegroup" label="cuttree: groups"
															selected="true" />
														<!--  listitem value="cuttreegroup_norm" label="cuttree: groups (relative # of groups)"/ -->
														<listitem
															value="cuttreeheight" label="cuttree: height" />
														<listitem
															value="cuttreeheight_norm"
															label="cuttree: height (normalized log)" />
													</listbox>
													<vbox
														width="10px" />
													<decimalbox
														id="intboxKgroupThreshold" value="0" visible="false" />
													<!--  slider id="sliderCuttreeThreshold" mode="decimal" step="1.0" maxpos="100.0" minpos="0.0" curpos="75.0" visible="false" width="150px"/ -->
													<!--  textbox id="textboxCuttreeThreshold" value="75.0" readonly="true" width="60px" visible="false"/ -->
													<hbox>
														<slider
															id="sliderCuttreeThreshold" mode="decimal" step="1.0"
															maxpos="15.0" minpos="1.0" curpos="3.0" visible="true"
															width="200px" />
														<textbox
															id="textboxCuttreeThreshold" value="3.0"
															readonly="true" width="50px" style="font-size:12px"
															visible="true" />
													</hbox>
													<listbox
														id="listboxAutogroup" mold="select" width="150px"
														visible="false">
														<listitem
															value="pamk" label="pamk" />
														<listitem
															value="calinski" label="calinski" selected="true" />
													</listbox>
													<vbox
														height="20px" />
													<label
														value="Image resolution" />
													<listbox
														id="listboxImagesize" mold="select"
														style="width:240px!important;" visible="true">
														<listitem
															value="0" label="low (72dpi)" />
														<listitem
															value="2" label="medium (300dpi)" selected="true" />
														<listitem
															value="1" label="high (800dpi)" />
													</listbox>
													<button
														id="buttonHaploUpdate" label="Update"
														style="font-size:12px;" />
												</vbox>
											</div>
										</west>
										<center border="0" autoscroll="true">
											<vlayout>
												<tabbox>
													<tabs>
														<tab
															id="tabHaploHaploview" label="Haplotype"
															selected="true" />
														<tab
															id="tabHaploGroupAlleles" label="Group alleles" />
														<tab
															id="tabHaploAutogroups" label="Autogroup calculations" />
														<tab
															id="tabHaploTree" label="Phylogenetic tree"
															visible="false" />
													</tabs>
													<tabpanels>
														<tabpanel
															id="haplotypeFrame">
															<iframe
																id="iframeHaplotype" width="100%" height="490px" />
														</tabpanel>
														<tabpanel>
															<vbox
																id="vboxGroupAlleleFrequency" visible="false">
																<label
																	value="Group major alleles"
																	style="font-size:18px;font-weight:bold" />
																<button
																	id="buttonDownloadGroupMatrix"
																	class="z-download-alleles"
																	label="Download group alleles" width="200px" />
																<div
																	style="overflow:auto;position:relative">
																	<listbox
																		id="listboxGroupAlleleMatrix" width="80%">
																		<listhead
																			id="listheadGroupAlleleMatrix" sizable="true">
																			<listheader
																				label="KGROUP" sort="auto" />
																			<!--  listheader label="SAMPLES"/ -->
																			<listheader
																				label="SUBPOP:COUNT" />
																			<listheader
																				label="SAMPLES" sort="auto" />
																			<listheader
																				label="FREQUEMCY" sort="auto" />
																		</listhead>
																	</listbox>
																</div>
																<hbox
																	height="30px" />
																<label
																	value="Select a Phenotype to display value distribution for each group"
																	style="font-size:12px;font-weight:bold" />
																<button
																	id="buttonAddPhenValuesToMatrix"
																	label="Append values to table" visible="false" />
																<hbox
																	width="100%">
																	<vbox
																		width="700px">
																		<div
																			id="divGroupPhenoQuant" visible="false">
																			<hbox>
																				<label>
																					Type
																				</label>
																				<vbox
																					width="20px" />
																				<radiogroup
																					id="rgPhenochartType">
																					<hbox>
																						<radio
																							id="radioGroupPhenotypeBox" label="box plot"
																							radiogroup="rgPhenochartType" selected="true" />
																						<vbox
																							width="30px" />
																						<radio
																							id="radioGroupPhenotypeErrorbars"
																							label="error bars"
																							radiogroup="rgPhenochartType" />
																					</hbox>
																				</radiogroup>
																			</hbox>
																			<div
																				id="divGroupPhenoQuantBox">
																				<hbox>
																					<checkbox
																						id="checkboxOutlierGroupPhenotypeBox"
																						label="Show 1.5xIQR outliers" />
																					<vbox
																						width="100px" />
																					<label
																						value="(select region to show varieties)" />
																				</hbox>
																				<charts
																					id="chartGroupPhenotypeBox" type="boxplot"
																					title="Group phenotype quartiles" visible="false"
																					zoomType="xy" />
																			</div>
																			<charts
																				id="chartGroupPhenotypeErrorbars"
																				title="Group phenotype mean+stddev" zoomType="xy"
																				visible="false" />
																		</div>
																		<div
																			id="divGroupPhenoCat">
																			<hbox>
																				<checkbox
																					id="checkboxNormalizeStackedCategories"
																					label="Normalize category count" />
																				<vbox
																					width="100px" />
																				<label
																					value="(click region to show varieties)" />
																			</hbox>
																			<charts
																				id="chartGroupPhenotypeStacked" type="column"
																				title="Group phenotype value" visible="false"
																				zoomType="y" />
																		</div>
																	</vbox>
																	<vbox>
																		<label
																			id="labelGroupVarietyPhenotype" visible="false" />
																		<listbox
																			id="listboxGroupVarietyPhenotypeStacked"
																			visible="false" mold="paging" pageSize="20">
																			<listhead>
																				<listheader
																					label="VARIETY" sort="auto" />
																				<listheader
																					label="ACCESSION" sort="auto" />
																				<listheader
																					label="SUBPOP" sort="auto" />
																				<listheader
																					id="listheaderGroupVarietyPhenotypeStackedPhenotype"
																					sort="auto" />
																			</listhead>
																		</listbox>
																	</vbox>
																</hbox>
																<vbox
																	height="30px" />
																<hbox>
																	<vbox
																		width="200px">
																		<radiogroup
																			id="radiogroupGroupAllelefreqcount" />
																		<radiogroup
																			id="radiogroupGroupMajorminor" />
																		<hbox
																			height="30px" />
																		<radio
																			id="radioGroupShowAlleleFrequency"
																			label="Show allele frequency"
																			radiogroup="radiogroupGroupAllelefreqcount"
																			selected="true" />
																		<radio
																			id="radioGroupShowAlleleCount"
																			label="Show allele count"
																			radiogroup="radiogroupGroupAllelefreqcount" />
																		<radio
																			id="radioGroupShowGenotypeFrequency"
																			label="Show genotype frequency"
																			radiogroup="radiogroupGroupAllelefreqcount" />
																		<radio
																			id="radioGroupShowGenotypeCount"
																			label="Show genotype count"
																			radiogroup="radiogroupGroupAllelefreqcount" />
																		<hbox
																			height="10px" />
																		<radio
																			id="radioGroupMajorAlleles" label="Major alleles"
																			radiogroup="radiogroupGroupMajorminor"
																			selected="true" />
																		<radio
																			id="radioGroupMinorAlleles" label="Minor alleles"
																			radiogroup="radiogroupGroupMajorminor" />
																		<radio
																			id="radioGroup3rdAlleles" label="3rd alleles"
																			radiogroup="radiogroupGroupMajorminor" />
																		<radio
																			id="radioGroup4thAlleles" label="4th alleles"
																			radiogroup="radiogroupGroupMajorminor"
																			visible="false" />
																		<hbox
																			height="10px" />
																		<label
																			value="Click in legend to hide/show series" />
																		<button
																			id="buttonGroupResetzoom" label="Reset Zoom"
																			visible="false" />
																	</vbox>
																	<charts
																		id="chartGroupAlleleFrequency" type="line"
																		title="Group Allele frequency" width="1000"
																		height="400" zoomType="xy" />
																</hbox>
															</vbox>
														</tabpanel>
														<tabpanel>
															<iframe
																id="iframeAutogroups" width="100%" height="1000px" />
														</tabpanel>
														<tabpanel>
															<vbox>
																<hbox>
																	<button
																		id="buttonHaploDownloadNewick"
																		label="Download Newick" />
																	<vbox
																		width="20px" />
																	<button
																		id="buttonHaploDisplayTree" label="Display Tree" />
																</hbox>
																<iframe
																	id="iframeHaplotypeTree" width="100%"
																	height="1000px" />
															</vbox>
														</tabpanel>
													</tabpanels>
												</tabbox>
											</vlayout>
										</center>
									</borderlayout>
								</goldenpanel>
							</goldenlayout>
						</vlayout>
					</div>

				</vlayout>

			</div>


			<!-- ENDPOINT -->


			<n:div id="bodyContent" style="height:100%">
				<n:div class="wrapper">
					<!-- Sidebar Holder -->
					<n:div id="content" style="display:none;">
						<div>
							<div id="div_info" style="height:100vh ;">
								<n:div class="row"
									style="position: absolute;top:20%;left: 550px;margin-right:0px; margin-left:0px;">

									<n:div class="col-lg-6"
										style="box-shadow: 0 .15rem 1.75rem 0 rgba(58,59,69,.15)!important;">
										<n:div class="image_container"
											style="height:100%">
											<n:img class="img-fluid"
												src="assets/img/6.png" style="margin-top:10%;" />
										</n:div>

									</n:div>
									<n:div class="col-lg-5"
										style="margin-top: auto;margin-bottom: auto;box-shadow: 0 .15rem 1.75rem 0 rgba(58,59,69,.15)!important;padding:20px;">
										<n:div class="info">
											<n:h3>SNP Query</n:h3>
											<n:div class="summary">
												<n:p
													style="font-size: 12px;color: #706e6e;
    													font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen, Ubuntu, Fira Sans, Droid Sans, Helvetica Neue, sans-serif !important;">
													1.  Select two
													varieties to
													compare; OR
													<n:br />
													    Compare All
													Varieties, members
													of a Subpopulation
													<n:br />
													    or Variety List,
													with the Reference
													<n:br />
													 2. Specify
													region(chromosome,
													start and end)
													<n:br />
													            Gene
													Os_xxGyyyyyyy (RAPDB
													name)
													<n:br />
													            or
													LOC_OsxxGyyyyy
													(RGAP7 name)
													<n:br />
													 3. Set options and
													click action button
												</n:p>
												<n:h5>Results</n:h5>
												<n:p
													style="font-size: 12px;color: #706e6e;
    													font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen, Ubuntu, Fira Sans, Droid Sans, Helvetica Neue, sans-serif !important;">
													  Table: Allele for
													Varieties x SNP
													positions
													<n:br />
													  JBrowse: SNPs plot
													in genome
													<n:br />
													  Tree: Phylogenetic
													tree based on the
													number
													<n:br />
													  of allele
													mismatches in the
													region
													<n:br />
													  PhyloJBrowse: SNPs
													in JBrowse with
													varieties
													<n:br />
													  ordered using
													phylotree clustering
													result.
												</n:p>
											</n:div>
										</n:div>
									</n:div>
								</n:div>
							</div>
						</div>
					</n:div>
				</n:div>
			</n:div>
			<popup id="popupMySNPList" width="300px">
				<html>




















					
