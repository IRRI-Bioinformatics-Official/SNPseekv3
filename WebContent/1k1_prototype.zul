												<radio
													id="radioShowGenotypeFrequency"
													label="Show genotype frequency"
													radiogroup="radiogroupAllelefreqcount"
													style="font-size:11px;" />
												<radio
													id="radioShowGenotypeCount" label="Show genotype count"
													radiogroup="radiogroupAllelefreqcount"
													style="font-size:11px;" />
												<hbox height="10px" />
												<radio
													id="radioMajorAlleles" label="Major alleles"
													radiogroup="radiogroupMajorminor" selected="true"
													style="font-size:11px;" />
												<radio
													id="radioMinorAlleles" label="Minor alleles"
													radiogroup="radiogroupMajorminor" style="font-size:11px;" />
												<radio
													id="radio3rdAlleles" label="3rd alleles"
													radiogroup="radiogroupMajorminor" style="font-size:11px;" />
												<radio
													id="radio4thAlleles" label="4th alleles"
													radiogroup="radiogroupMajorminor" visible="false"
													style="font-size:11px;" />
												<hbox height="10px" />
												<label
													value="Click in legend to hide/show series"
													style="font-size:11px;" />
												<button
													id="buttonResetzoom" label="Reset Zoom" visible="false" />
											</vbox>
											<charts
												id="chartAlleleFrequency" type="line"
												title="Allele frequency" width="1000" height="400"
												zoomType="xy" />
										</hbox>
									</goldenpanel>

									<goldenpanel id="gp_pairwise"
										area="A" title="Pairwise Variety Comparison Table"
										droppable="false" closable="false">
										<div id="divPairwise"
											visible="false">
											<hbox>
												<label pre="true"
													value="Download  " style="font-weight:bold;" />
												<button
													id="buttonDownloadPairwiseCsv" label="CSV" width="60px"
													height="30px" autodisable="self" />
												<vbox width="10px" />
												<button
													id="buttonDownloadPairwiseTab" label="Tab" width="60px"
													height="30px" autodisable="self" />
											</hbox>
											<hbox height="10px" />
											<listbox
												id="listboxSnpresult" class="pairwise-table"
												fixedLayout="true" mold="paging" pageSize="100">
												<auxhead
													id="auxheadMultirefPairwise" visible="false">
													<auxheader
														id="auxheaderMultirefPairwise" label="" colspan="3" />
													<auxheader
														label="NIPPONBARE" colspan="3" />
													<auxheader
														label="COMPARE VARIETIES" colspan="2" />
												</auxhead>
												<listhead
													class="haplotype-table">
													<listheader
														id="listheader1MultirefPairwise" visible="false"
														label="CONTIG" />
													<listheader
														id="listheader2MultirefPairwise" visible="false"
														label="POSITION" />
													<listheader
														id="listheader3MultirefPairwise" visible="false"
														label="REFERENCE" />
													<listheader
														label="CONTIG" />
													<listheader
														label="POSITION" />
													<listheader
														id="listHeaderVar2Reference" label="NPB REFERENCE" />
													<listheader
														id="listheaderVar1MultirefPairwise" />
													<listheader
														id="listheaderVar2MultirefPairwise" />
												</listhead>
											</listbox>
										</div>
									</goldenpanel>

									<goldenpanel id="gp_snpeffect"
										area="A" title="Snp Effect" closable="false">
										<vlayout>
											<toolbar
												id="toolbar_download" visible="false">
												<hlayout>
													<button
														id="btn_downloadSnpEffect" label="Download" />
												</hlayout>
											</toolbar>
											<listbox id="listboxSnpeff"
												mold="paging" pageSize="15" sizedByContent="true"
												span="true">
												<listhead
													sizable="true">
													<listheader
														label="POSITION" sort="auto" width="10%" />
													<listheader
														label="&quot;DELETERIOUSNESS&quot;" sort="auto"
														width="10%" sortAscending="${snpeffasc1}"
														sortDescending="${snpeffdsc1}" />
													<listheader
														label="Alt (ANN)" sort="auto" width="100px" />
													<listheader
														label="Effect (ANN)" sort="auto" width="100px" />
													<listheader
														label="Putative_impact (ANN)" sort="auto" width="10%" />
													<listheader
														label="Gene Name (ANN)" sort="auto" width="10%" />
													<listheader
														label="Gene ID (ANN)" sort="auto" width="10%" />
													<listheader
														label="Feature type (ANN)" sort="auto" width="10%" />
													<listheader
														label="Feature ID (ANN)" sort="auto" width="10%" />
													<listheader
														label="Transcript Biotype (ANN)" sort="auto" width="10%" />
													<listheader
														label="Rank/Total (ANN)" sort="auto" width="10%" />
													<listheader
														label="HGV S.c (ANN)" sort="auto" width="10%" />
													<listheader
														label="HGV S.p (ANN)" sort="auto" width="10%" />
													<listheader
														label="cDNA position (ANN)" sort="auto" width="10%" />
													<listheader
														label="cDS position (ANN)" sort="auto" width="10%" />
													<listheader
														label="Protein position" sort="auto" width="10%" />
													<listheader
														label="Distance to feature (ANN)" sort="auto" width="10%" />
													<listheader
														label="Errors,Warnings Info msgs (ANN)" sort="auto"
														width="10%" />
													<listheader
														label="LOF" sort="auto" width="10%" />
													<listheader
														label="NMD" sort="auto" width="10%" />
												</listhead>
											</listbox>
										</vlayout>
									</goldenpanel>

									<goldenpanel id="gp_jbrowse"
										area="A" title="Jbrowse" draggable="true" closable="false">
										<vbox
											style="height:100%;width:100%;">
											<hbox>
												<label id="msgJbrowse"
													visible="false" style="font-size:16px;" />
												<hbox width="80px" />
												<div id="divNucleotide"
													visible="false">
													<label
														value="SNP Genotype Track color code:     " pre="true" />
													<label value="A  "
														style="color:green;" pre="true" />
													<label value="T  "
														style="color:red;" pre="true" />
													<label value="G  "
														style="color:orange;" pre="true" />
													<label value="C  "
														style="color:blue;" pre="true" />
													<label
														value="heterozygous   "
														style="color:yellow;background:gray;" pre="true" />
												</div>
												<div
													id="divNucleotideIndels" visible="false">
													<label
														value="SNP Genotype Track color code:     " pre="true" />
													<label
														value="insertion  " style="color:green;" pre="true" />
													<label
														value="snp/substitution   " style="color:red;" pre="true" />
													<label
														value="deletion  " style="color:blue;" pre="true" />
													<label
														value="heterozygous   "
														style="color:yellow;background:gray;" pre="true" />
													<label
														value="reference   " style="color:black;" pre="true" />
												</div>
												<div id="divMismatch"
													visible="false">
													<label
														value="SNP Genotype Track color code:     " pre="true" />
													<label
														value="non-synonymous mismatch " style="color:red;"
														pre="true" />
													<label
														value="synonymous mismatch " style="color:darkgray;"
														pre="true" />
													<label
														value="heterozygous   "
														style="color:yellow;background:gray;" pre="true" />
													<label
														value="splice donor SNP " style="color:aqua;" pre="true" />
													<label
														value="splice acceptor SNP " style="color:chartreuse;"
														pre="true" />
												</div>
											</hbox>
											<iframe id="iframeJbrowse"
												align="left" visible="true"
												style="width:100%;height:100%;border:0px inset;"
												src="${jbrowsestart}" />
										</vbox>
									</goldenpanel>

									<goldenpanel id="gp_template"
										area="A" title="template" draggable="true" closable="false" />
									<goldenpanel id="gp_haplotype"
										area="A" title="Haplotype" draggable="true" closable="false" />
								</goldenlayout>
							</vlayout>
						</div>
					</div><!-- end results-section -->

				</vlayout>
			</div>

			<!-- Info sidebar content (hidden) -->
			<n:div id="bodyContent" style="height:100%">
				<n:div class="wrapper">
					<n:div id="content" style="display:none;">
						<div>
							<div id="div_info" style="height:100vh;">
								<n:div class="row"
									style="position:absolute;top:20%;left:550px;margin-right:0px;margin-left:0px;">
									<n:div class="col-lg-6"
										style="box-shadow:0 .15rem 1.75rem 0 rgba(58,59,69,.15)!important;">
										<n:div class="image_container"
											style="height:100%">
											<n:img class="img-fluid"
												src="assets/img/6.png" style="margin-top:10%;" />
										</n:div>
									</n:div>
									<n:div class="col-lg-5"
										style="margin-top:auto;margin-bottom:auto;box-shadow:0 .15rem 1.75rem 0 rgba(58,59,69,.15)!important;padding:20px;">
										<n:div class="info">
											<n:h3>SNP Query</n:h3>
											<n:div class="summary">
												<n:p
													style="font-size:12px;color:#706e6e;">
													1. Select two
													varieties to
													compare; OR
													<n:br />
													Compare All
													Varieties, members
													of a Subpopulation
													<n:br />
													or Variety List,
													with the Reference
													<n:br />
													2. Specify
													region(chromosome,
													start and end)
													<n:br />
													Gene Os_xxGyyyyyyy
													(RAPDB name)
													<n:br />
													or LOC_OsxxGyyyyy
													(RGAP7 name)
													<n:br />
													3. Set options and
													click action button
												</n:p>
												<n:h5>Results</n:h5>
												<n:p
													style="font-size:12px;color:#706e6e;">
													Table: Allele for
													Varieties x SNP
													positions
													<n:br />
													JBrowse: SNPs plot
													in genome
													<n:br />
													Tree: Phylogenetic
													tree based on the
													number
													<n:br />
													of allele mismatches
													in the region
													<n:br />
													PhyloJBrowse: SNPs
													in JBrowse with
													varieties
													<n:br />
													ordered using
													phylotree clustering
													result.
												</n:p>
											</n:div>
										</n:div>
									</n:div>
								</n:div>
							</div>
						</div>
					</n:div>
				</n:div>
			</n:div>

			<popup id="popupMySNPList" width="300px">
				<html>
					
					<![CDATA[Get only alleles from positions in the
					list. <br />1kRiCA list contains the SNP positions
					for Version 3 of the panel <br />The list can also
					be created in <b>My List</b> in the menu.]]>
					
				</html>
			</popup>

		</window>
	</n:div>
</zk>
